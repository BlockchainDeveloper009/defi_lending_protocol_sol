# 1. Base image
FROM node:24.2.0

# 2. Switch to bash
# This ensures that /bin/sh points to /bin/bash, which is often more feature-rich
# and consistent than the default /bin/sh (which might be dash on Debian/Ubuntu).
RUN rm /bin/sh && ln -s /bin/bash /bin/sh

# 3. Set up Rust environment
# Define Rust-related environment variables on separate lines for clarity and Docker build-time parsing.
ENV CARGO_HOME="/root/.cargo"
ENV RUSTUP_HOME="/root/.rustup"
# Add Cargo's bin directory to the PATH so Rust executables are found.
ENV PATH="${CARGO_HOME}/bin:${PATH}"

# 4. Install system dependencies
# Update apt and install necessary packages required for building Solana programs.
# --no-install-recommends avoids installing unnecessary packages.
# apt clean and rm -rf /var/lib/apt/lists/* reduce the final image size.
RUN apt update && apt install -y --no-install-recommends \
    ca-certificates libssl-dev libudev-dev pkg-config \
    zlib1g-dev llvm clang make curl nano git procps \
    && apt clean && rm -rf /var/lib/apt/lists/*

# 5. Pin Rust toolchain
# Copy the .rust-toolchain.toml file to ensure Rustup installs the exact toolchain version.
COPY ./lending_backend_solana/.rust-toolchain.toml ./
# Install Rustup and the specified toolchain. -y answers yes to prompts.
RUN curl https://sh.rustup.rs -sSf | bash -s -- -y

# 6. Verify Rust toolchain
# Source the cargo environment script and show the installed Rustup toolchain.
# This confirms Rust is correctly set up.
RUN /bin/bash -c "source $HOME/.cargo/env && rustup show"

# 7. Pin compatible Solana CLI version for Anchor
ENV SOLANA_VERSION=v1.18.14
# Define the base directory for Solana installation for clear reference.
ENV SOLANA_INSTALL_DIR="/root/.local/share/solana/install/active_release"

# Use Anza's installer for Solana CLI. The previous SSL_ERROR_SYSCALL issue was the reason for this switch.
# This RUN command only performs the installation itself.
RUN sh -c "$(curl -sSfL https://release.anza.xyz/${SOLANA_VERSION}/install)"

# IMPORTANT: Add Solana's bin directory to PATH for all *subsequent* steps.
# Using ENV here makes the PATH change persistent across all following RUN commands
# and when the container is run.
ENV PATH="${SOLANA_INSTALL_DIR}/bin:${PATH}"

# 8. Confirm Solana CLI install
# 'solana' should now be found directly because the PATH ENV was set in the previous step.
# Source cargo environment again to ensure all build-related PATHs are correct.
RUN /bin/bash -c "source $HOME/.cargo/env && solana --version"

# 9. Copy SBF SDK if available (This step remains commented out)
# This was causing issues by trying to copy SDK components into a non-standard path.
# The Solana CLI installer (Anza) handles the placement of its SBF SDK components correctly,
# and `cargo-build-sbf` should find them automatically when the PATH is set.
# RUN if [ -d "/root/.local/share/solana/install/active_release/sbf" ]; then \
#         mkdir -p /usr/local/bin/platform-tools-sdk && \
#         cp -r /root/.local/share/solana/install/active_release/sbf /usr/local/bin/platform-tools-sdk/sbf; \
#     else \
#         echo "⚠️ No SBF SDK found — check if Solana CLI version changed."; \
#     fi

# 10. Global Node tools
# Install common Node.js development tools globally.
RUN npm install -g mocha ts-node

# 11. Git fetch via CLI
# This environment variable improves Git performance when Cargo fetches dependencies.
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true

# 12. Install Anchor CLI matching your toolchain
# Install the Anchor CLI from its Git repository at a specific tag (v0.31.1).
# --locked ensures deterministic builds based on the Cargo.lock file.
RUN /bin/bash -c "source $HOME/.cargo/env && \
    cargo install --git https://github.com/coral-xyz/anchor \
      anchor-cli --tag v0.31.1 --locked"

# 13. Include your prebuilt binaries
# COPY prebuilt 'anchor' binary.
# REMOVED: COPY binaries/cargo-build-sbf - we rely on the one installed by the Solana CLI.
COPY binaries/anchor /usr/local/bin/anchor
# Make the copied binary executable.
RUN chmod +x /usr/local/bin/anchor

# 14. Set workdir & copy code
# Set the working directory for the container.
WORKDIR /solana
# Copy all local files into the /solana directory in the container.
COPY . .

# Make the docker-entrypoint.sh script executable (if it exists).
RUN chmod +x ./docker-entrypoint.sh || true
# Change working directory to your specific backend project.
WORKDIR /solana/lending_backend_solana

# 15. Build your Anchor project - Step 1: Source Cargo environment
# Split into multiple RUN commands for better debugging.
# This sets up PATH for Rust/Cargo tools for this specific build operation.
RUN /bin/bash -c "source $HOME/.cargo/env"

# 16. Build your Anchor project - Step 2: Verify Solana CLI version
# This confirms Solana CLI is accessible and prints its version.
RUN /bin/bash -c "source $HOME/.cargo/env && solana --version"

# 17. Build your Anchor project - Step 3: Build Anchor project
# This compiles your smart contracts using Anchor.
# 'anchor build' should now find the correct cargo-build-sbf via the updated PATH.
RUN /bin/bash -c "source $HOME/.cargo/env && \
    export CARGO_PROFILE_RELEASE_BUILD_OVERLAP_COPY_MAX_METERS=10000000 && \
    export RUST_BACKTRACE=1 && \
    anchor build"

# 18. Default entrypoint
# The command that will be executed when the container starts.
CMD ["./docker-entrypoint.sh"]